  "principles": [
    {
      "title": "Local-first where it matters",
      "text": "Data stays on your own machine unless there’s a good reason to move it."
    },
    {
      "title": "Automate the repetitive, keep people in control",
      "text": "Automation should remove busywork, not judgement. The final call stays with a person."
    },
    {
      "title": "Built to be run, not just demoed",
      "text": "Tests, CI, installers, and containers from the start, so a project keeps working after launch day."
    },
    {
      "title": "Clear about the limits",
      "text": "Every signal explains itself and every experimental feature is labelled. Knowing what something can’t do builds trust."
    }
